[
  {
    "kernelSource": {
      "name": "Redmi-Pad-2-taiko-GKI-6.12",
      "repo": "https://android.googlesource.com/kernel/common",
      "branch": "android16-6.12",
      "device": "taiko"
    },
    "withKernelSU": true,
    "toolchains": [
      {
        "repo": "https://android.googlesource.com/platform/prebuilts/gas/linux-x86",
        "branch": "main",
        "name": "gas"
      },
      {
        "repo": "https://gitlab.com/ThankYouMario/android_prebuilts_clang-standalone/",
        "branch": "18",
        "name": "clang"
      }
    ],
    "params": {
      "ARCH": "arm64",
      "CROSS_COMPILE": "aarch64-linux-gnu-",
      "CLANG_TRIPLE": "aarch64-linux-gnu-",
      "CC": "clang",
      "LLVM": "1",
      "LLVM_IAS": "1",
      "fragments": [
        "CONFIG_NAMESPACES=y",
        "CONFIG_UTS_NS=y",
        "CONFIG_IPC_NS=y",
        "CONFIG_USER_NS=y",
        "CONFIG_PID_NS=y",
        "CONFIG_NET_NS=y",
        "CONFIG_CGROUPS=y",
        "CONFIG_CGROUP_FREEZER=y",
        "CONFIG_CGROUP_PIDS=y",
        "CONFIG_CGROUP_DEVICE=y",
        "CONFIG_CGROUP_CPUACCT=y",
        "CONFIG_MEMCG=y",
        "CONFIG_MEMCG_SWAP=y",
        "CONFIG_OVERLAY_FS=y",
        "CONFIG_SQUASHFS=y",
        "CONFIG_VETH=y",
        "CONFIG_BRIDGE=y",
        "CONFIG_TUN=y",
        "CONFIG_SYSVIPC=y"
      ]
    }
  }
]
